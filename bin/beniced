#!/bin/bash
# =============================================================================
# beniced — block device health sampler + PSI stall detector
#           + reactive throttle (multi-disk capable)          [ the BeNice sampler ]
#
# System-wide service (runs as root, user-independent). Watches ONE OR MORE
# block devices (DISKS in /etc/benice/benice.conf) and emits one log
# line per disk per run.
#
# Log line format (key=value, machine-parseable; ONE LINE PER DISK per run):
#   <ts> dev=sda load_1m=N load_5m=N load_15m=N in_flight=N iops_read=N
#        iops_write=N busy_ms_delta=Nms util_pct=N iowait_pct=N
#        kernel_io_errors=N fs_errors=N psi_io_some_max=N psi_io_full_max=N
#        sched=<elevator> status=OK|WARN [alerts="…"]
#   When PSI stall triggers, "offenders:" and "action:" lines are appended
#   separately after the per-disk lines; demotion recovery emits "restored:"
#   lines in the same style.
#
#   per-disk fields : in_flight, iops_read/write, busy_ms_delta, util_pct,
#                     fs_errors, sched, dev
#   global fields   : load*, iowait_pct, kernel_io_errors, psi_io_*_max
#   status=MISSING  : configured disk not present in /sys/block (skipped run);
#                     emitted with alerts="MISSING_DEV" plus an ALERT line
#                     carrying that context (never a bare ALERT)
#   status=WARN     : any alert fired, incl. MISSING_PSI (see below)
#
# Field reference (standard terminology):
#   in_flight      /proc/diskstats field 12  — I/Os currently in progress
#                   (queue depth snapshot; >8 sustained = device stalling)
#   iops_read      reads/s over the interval (iostat "r/s")
#   iops_write     writes/s over the interval (iostat "w/s")
#   busy_ms_delta  device-busy milliseconds over the interval (the "%util"
#                   numerator); util_pct = busy_ms_delta / interval
#   iowait_pct     CPU time waiting for I/O (vmstat "wa")
#   psi_io_*_max   peak /proc/pressure/io "some"/"full" avg10 sampled over the
#                   window — CPU tasks stalled on I/O. full>25 sustained =
#                   real stall territory.
#   kernel_io_errors  journalctl -k count of REAL I/O error lines
#                   ("I/O error", "EXT4-fs error", "medium error", "blk_update").
#                   NOTE: benign "EXT4-fs (sda2): mounted…" lines do NOT match.
#   fs_errors      sum of errors_count across the disk's partitions (any
#                   filesystem exposing /sys/fs/<fstype>/<part>/errors_count,
#                   e.g. ext4) — filesystem-recorded errors
#
# PSI prerequisite: if /proc/pressure/io is unreadable, stall detection is
# inactive — every emitted line gets status=WARN with MISSING_PSI in alerts
# and one stderr/journal line explains it (see README Prerequisites). Device
# health sampling still proceeds normally.
#
# THROTTLE: when psi_io_full_max >= PSI_TRIG, the top I/O consumers over the
# window (from /proc/<pid>/io deltas) are logged as offN=… and — if
# MITIGATE>=1 — demoted with `ionice -c3` + `renice 19`. Runs as root, so any
# user's runaway process can be demoted (never PID 1/kernel threads).
#   Before demotion the process's original nice AND its I/O class+priority
#   (read back via `ionice -p`, ioprio_get) are recorded, so the demotion
#   can later be undone EXACTLY (see Demotion recovery).
#   Time-normalized threshold (F4): a process qualifies when its window delta
#   is >= IO_TRIG_MBPS MiB *per window* (MBPS * window seconds); the offN
#   label therefore reports MiB per window, not MB/s.
#   PID-reuse safety (F5): snapshots record /proc/<pid>/stat starttime
#   (field 22, parsed after the last ')' — comm may contain spaces/parens)
#   next to the pid; the A/B join requires BOTH to match, and every action
#   re-reads the live starttime and skips on mismatch — a reused pid drops
#   out instead of being acted on.
#   NOTE on sched: ionice is fully honored only by BFQ. If the active elevator
#   is mq-deadline, ionice is mostly cosmetic; renice still helps the CPU side.
#   After the first successful demotion on a non-BFQ elevator a ONE-TIME
#   "hint: scheduler is <sched> — ionice demotion is fully binding only under
#   bfq" line is emitted (once per mitigate.state lifetime, key hint_bfq=1).
#
# MITIGATE=2 pendulum (orphan-safe, F7): the intended frozen pid is recorded
# in MSTATE BEFORE kill -STOP; an EXIT/TERM/INT trap SIGCONTs it, and the
# start of every run SIGCONTs any recorded pid unconditionally — so even a
# SIGKILLed run heals on the next run. The freeze therefore lasts at most
# until the end of the run that issued it (bounded, never inter-run).
#
# Demotion recovery (F6 + I1/I2): each demoted pid is stored as
# "pid:starttime:nice:iclass:iprio:clean" — the recorded nice AND I/O
# class+level (iclass/iprio, read back via `ionice -p` before demotion)
# allow an EXACT restore, plus a PER-ENTRY clean counter. On EVERY run each
# entry's counter resets to 0 if its pid+starttime was among this run's
# top I/O consumers (the tops set), else it increments; an entry that
# reaches clean=2 is restored — REGARDLESS of the global trigger — so a
# one-time victim caught in storm #1 is not held hostage by a chronic
# offender that keeps re-triggering (per-entry fairness). Restore =
# renice to the recorded nice + ionice to the recorded class/level
# ("be:N" / "rt:N" / "idle"). A captured class of 0 ("none" — never
# explicitly set) is restored as best-effort with the KERNEL-DERIVED
# priority (cpu_nice + 20) / 5, logged as "ionice=be:N (kernel default)".
# Legacy 3-field entries (pid:starttime:nice) parse with the old restore
# defaults iclass=2 iprio=4 and start clean at 0. Exited pids are dropped
# silently.
#
# ALERT rules (status=WARN, also emitted as a greppable "ALERT:" line):
#   kernel_io_errors delta > 0        → device/kernel-level I/O failures
#   fs_errors > 0                     → filesystem recorded errors
#   in_flight > 8                     → device stalling
#   util_pct > 80 over the interval   → saturated
#   psi_io_full_max >= PSI_TRIG       → stall detected, offenders reported
#   PSI unavailable                   → MISSING_PSI on every emitted line
#
# First run after a state reset logs status=BASELINE (no deltas, no alerts).
#
# State files (LIB_DIR, normally /var/lib/benice):
#   state.<dev>      per-disk counters, 6 whitespace-separated fields:
#                      <epoch> <uptime_s> <io_ms> <reads> <writes> <io_err>
#                    uptime_s (/proc/uptime) is the monotonic interval source;
#                    old 5-field files (no uptime_s) are read via the epoch
#                    fallback and upgraded on the next write.
#   mitigate.state   key=value lines (one per line), written every run:
#                      last=<epoch>               last mitigation pass (cooldown)
#                      stopped_pid=<pid>          pid frozen by MITIGATE=2 (0=none)
#                      stopped_start=<starttime>  its /proc/<pid>/stat starttime
#                      hint_bfq=1                 non-BFQ hint already emitted
#                      demoted=<pid>:<starttime>:<nice>:<iclass>:<iprio>:<clean> …
#                                                 space-separated; iclass/iprio =
#                                                 original I/O class+level
#                                                 (iclass 0 = never set → the
#                                                 kernel default is re-derived
#                                                 at restore); clean = per-entry
#                                                 consecutive clean runs
#                    Pre-hardening files ("epoch pid" on one line) match no
#                    key and are silently reset to defaults. Old files with a
#                    global "clean=" line and 3-field demoted entries upgrade
#                    to the current format on the next write.
#
# Configuration: /etc/benice/benice.conf
#   (template: config/benice.conf.example in the project repo)
#   DISKS="sda"        space-separated list of block devices to watch
#                      (deprecated alias: DEV=sda)
#   PSI_TRIG=25        /proc/pressure/io "full avg10" % that counts as a stall
#                      (clamped to a minimum of 1)
#   PSI_WINDOW=30      seconds spent sampling PSI per run
#   PSI_STEP=5         seconds between PSI samples
#   IO_TRIG_MBPS=5     min MiB accumulated over the PSI window for a process
#                      to be reported/throttled (time-normalized from MiB/s;
#                      the log label shows MiB per window)
#   MITIGATE=0|1|2     0 observe only · 1 ionice+renice offenders (default)
#                      2 additionally SIGSTOP the top offender until the end
#                      of the run (orphan-safe pendulum — see above; do NOT
#                      use on services that must stay responsive!)
#   COOLDOWN=300       minimum seconds between mitigation actions
# =============================================================================
set -u
CONF="/etc/benice/benice.conf"
[ -r "$CONF" ] && . "$CONF"

# test/CI seams: directories can be redirected without touching the config
LOG_DIR=${BENICE_LOG_DIR:-/var/log/benice}
LIB_DIR=${BENICE_LIB_DIR:-/var/lib/benice}
LOG="$LOG_DIR/benice.log"

# disks to watch: DISKS = space-separated list (DEV kept as deprecated alias)
DISKS=${DISKS:-${DEV:-sda}}

PSI_TRIG=${PSI_TRIG:-25}
PSI_WINDOW=${PSI_WINDOW:-30}
PSI_STEP=${PSI_STEP:-5}
IO_TRIG_MBPS=${IO_TRIG_MBPS:-5}
MITIGATE=${MITIGATE:-1}
COOLDOWN=${COOLDOWN:-300}

# F11: clamp PSI_TRIG to >= 1 so the "0 >= 0" always-true seam is gone
case $PSI_TRIG in ''|*[!0-9]*) PSI_TRIG=25 ;; esac
[ "$PSI_TRIG" -lt 1 ] && PSI_TRIG=1
case $IO_TRIG_MBPS in ''|*[!0-9]*) IO_TRIG_MBPS=5 ;; esac

# ensure runtime dirs exist (self-healing; installer normally creates them)
mkdir -p "$LOG_DIR" "$LIB_DIR" 2>/dev/null || true

# --- /proc/<pid>/stat helpers -------------------------------------------------
# comm (field 2) may contain spaces/parens — always parse AFTER the last ')'.
# After the strip, positional N corresponds to kernel field N+2:
#   field 19 (nice) -> ${17}, field 22 (starttime) -> ${20}.
#   NB: braces are REQUIRED — $17/$20 would expand as ${1}+"7" / ${2}+"0".
proc_starttime() {   # pid -> starttime (jiffies since boot); fails if gone
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  # shellcheck disable=SC2086  # intentional split on stat fields
  set -- ${s##*) }
  printf '%s\n' "${20}"   # NB: braced — $20 would mean ${2}+"0"
}
proc_nice() {        # pid -> current nice (field 19)
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  # shellcheck disable=SC2086  # intentional split on stat fields
  set -- ${s##*) }
  printf '%s\n' "${17}"   # NB: braced — $17 would mean ${1}+"7"
}
proc_alive() {       # pid starttime -> true iff pid exists AND starttime matches
  [ -n "${2:-}" ] && [ "${2:-}" != "0" ] || return 1
  local cur
  cur=$(proc_starttime "$1") || return 1
  [ "$cur" = "$2" ]
}
num_ok() { case ${1:-} in ''|*[!0-9]*) return 1 ;; esac; return 0; }

# --- ionice readback + demoted-entry helpers (I1/I2) ---------------------------
# `ionice -p <pid>` reads the kernel's current I/O priority back (ioprio_get):
#   "none: prio 0"        class 0 — never explicitly set; the kernel derives
#                          the effective level from the CPU nice at request
#                          time: BE level = (nice + 20) / 5
#   "idle"                class 3, level 0
#   "best-effort: prio N" class 2, level N
#   "realtime: prio N"    class 1, level N
ionice_get() {       # pid -> prints "<iclass> <iprio>"; rc 1 = fallback used
  local out cls pri
  out=$(ionice -p "$1" 2>/dev/null) || { printf '2 4\n'; return 1; }
  case $out in
    idle|idle:*)    printf '3 0\n' ;  return 0 ;;
    none|none:*)    printf '0 0\n' ;  return 0 ;;
    best-effort:*)  cls=2 ;;
    realtime:*)     cls=1 ;;
    *)              printf '2 4\n' ;  return 1 ;;
  esac
  pri=${out##*prio }
  case $pri in ''|*[!0-9]*) printf '2 4\n'; return 1 ;; esac
  printf '%s %s\n' "$cls" "$pri"
}
demoted_parse() {    # entry -> d_pid d_start d_nice d_iclass d_iprio d_clean;
                     # tolerant: legacy 3-field "p:s:n" gets the old restore
                     # defaults iclass=2 iprio=4 and starts clean at 0
  local e=$1
  d_pid=${e%%:*};   e=${e#*:}
  d_start=${e%%:*}; e=${e#*:}
  d_nice=${e%%:*};  e=${e#*:}
  d_iclass=2; d_iprio=4; d_clean=0
  case $e in
    *:*:*) d_iclass=${e%%:*}; e=${e#*:}; d_iprio=${e%%:*}; d_clean=${e#*:} ;;
  esac
  case $d_pid    in ''|*[!0-9]*) d_pid=0 ;;    esac
  case $d_start  in ''|*[!0-9]*) d_start=0 ;;  esac
  case $d_nice   in ''|*[!0-9]*) d_nice=0 ;;   esac
  case $d_iclass in ''|*[!0-9]*) d_iclass=2 ;; esac
  case $d_iprio  in ''|*[!0-9]*) d_iprio=4 ;;  esac
  case $d_clean  in ''|*[!0-9]*) d_clean=0 ;;  esac
  [ "$d_iclass" -gt 3 ] && d_iclass=2          # only classes 0-3 are real
  [ "$d_iprio"  -gt 7 ] && d_iprio=4           # BE/RT levels are 0-7
}
restore_ionice() {   # pid nice iclass iprio -> sets r_label + r_kdef
                     # rc 0 = applied · rc 1 = ionice failed (r_label "")
  local pid=$1 nice=$2 iclass=$3 iprio=$4
  r_kdef=0
  if [ "$iclass" -eq 0 ]; then
    iclass=2                                # never explicitly set: re-pin the
    iprio=$(( (nice + 20) / 5 ))            # kernel-derived default BE level
    r_kdef=1
  fi
  if [ "$iclass" -eq 3 ]; then
    if ionice -c 3 -p "$pid" >/dev/null 2>&1; then r_label="idle"; return 0; fi
    return 1
  fi
  if ionice -c "$iclass" -n "$iprio" -p "$pid" >/dev/null 2>&1; then
    if [ "$iclass" -eq 1 ]; then r_label="rt:$iprio"; else r_label="be:$iprio"; fi
    return 0
  fi
  return 1
}

# --- mitigation state (format documented in the header) -----------------------
MSTATE="$LIB_DIR/mitigate.state"
m_last=0; m_stopped_pid=0; m_stopped_start=0; m_hint_bfq=0; m_demoted=""
if [ -f "$MSTATE" ]; then
  while IFS= read -r mline; do
    case $mline in
      last=*)          num_ok "${mline#last=}"          && m_last=${mline#last=} ;;
      stopped_pid=*)   num_ok "${mline#stopped_pid=}"   && m_stopped_pid=${mline#stopped_pid=} ;;
      stopped_start=*) num_ok "${mline#stopped_start=}" && m_stopped_start=${mline#stopped_start=} ;;
      hint_bfq=*)      num_ok "${mline#hint_bfq=}"      && m_hint_bfq=${mline#hint_bfq=} ;;
      demoted=*)       m_demoted=${mline#demoted=} ;;
    esac
  done < "$MSTATE"
fi
mstate_write() {
  printf 'last=%s\nstopped_pid=%s\nstopped_start=%s\nhint_bfq=%s\ndemoted=%s\n' \
    "$m_last" "$m_stopped_pid" "${m_stopped_start:-0}" "$m_hint_bfq" "$m_demoted" \
    > "$MSTATE" 2>/dev/null || true
}
demoted_has() {      # pid starttime -> true if already on the demoted list
  local e p s
  # shellcheck disable=SC2086  # intentional word split over the list
  for e in ${m_demoted:-}; do
    p=${e%%:*}; s=${e#*:}; s=${s%%:*}
    [ "$p" = "$1" ] && [ "$s" = "$2" ] && return 0
  done
  return 1
}

# F7: at the start of EVERY run, SIGCONT the previously recorded frozen pid
# unconditionally (heals a SIGKILLed predecessor run; no-op otherwise).
if [ "$m_stopped_pid" != "0" ] && proc_alive "$m_stopped_pid" "$m_stopped_start"; then
  kill -CONT "$m_stopped_pid" 2>/dev/null || true
fi
m_stopped_pid=0; m_stopped_start=0    # re-recorded below if we freeze someone anew

# F7: safety net — never leave a frozen process behind on exit/TERM/INT
stopped_pid=0; stopped_start=0
cleanup() {
  if [ "$stopped_pid" != "0" ]; then
    if proc_alive "$stopped_pid" "$stopped_start"; then
      kill -CONT "$stopped_pid" 2>/dev/null || true
    fi
    m_stopped_pid=0; m_stopped_start=0
    mstate_write
  fi
  rm -f "${TMP_A:-}" "${TMP_B:-}" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# --- collect GLOBAL counters ---------------------------------------------------
now=$(date '+%F %T')
epoch=$(date +%s)
up_now=$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null)  # F9: monotonic clock
num_ok "$up_now" || up_now=0
load1=$(cut -d' ' -f1 /proc/loadavg); load5=$(cut -d' ' -f2 /proc/loadavg); load15=$(cut -d' ' -f3 /proc/loadavg)
ioerr=$(journalctl -k --no-pager 2>/dev/null | grep -ciE 'I/O error|EXT4-fs error|medium error|blk_update')
iowait_pct=$(vmstat 1 2 2>/dev/null | tail -1 | awk '{print $16}'); iowait_pct=${iowait_pct:-0}

# --- I/O per-process snapshot helper -----------------------------------------
# outputs "pid starttime total_bytes" lines (root can read every process);
# the starttime column makes the A/B join PID-reuse-proof (F5)
snap_io() {
  local p pid b st
  for p in /proc/[0-9]*; do
    pid=${p#/proc/}
    [ "$pid" = "$$" ] && continue
    [ "$pid" -le 2 ] && continue          # skip PID 1 and kernel threads
    st=$(proc_starttime "$pid") || continue
    b=$(awk '/^(read|write)_bytes/{s+=$2} END{print s+0}' "$p/io" 2>/dev/null) || continue
    [ "${b:-0}" -gt 0 ] && printf '%s %s %s\n' "$pid" "$st" "$b"
  done
}
TMP_A=$(mktemp) ; TMP_B=$(mktemp)

# F4: bracket the sampling window so the offender threshold is time-normalized
win_start=$(date +%s)
snap_io > "$TMP_A"

# --- PSI sampling window ------------------------------------------------------
psi_max_some=0; psi_max_full=0
psi_ok=1
if [ ! -r /proc/pressure/io ]; then
  psi_ok=0    # F1: stall detection inactive — say so, loudly
  echo "beniced: PSI unavailable — stall detection inactive (see README Prerequisites)" >&2
else
  waited=0
  while :; do
    s=$(awk '/^some/{v=$2} /^full/{f=$2} END{sub("avg10=","",v); sub("avg10=","",f); printf "%d %d", v+0, f+0}' /proc/pressure/io)
    s_some=${s% *}; s_full=${s#* }
    [ "${s_some:-0}" -gt "$psi_max_some" ] && psi_max_some=$s_some
    [ "${s_full:-0}"  -gt "$psi_max_full" ] && psi_max_full=$s_full
    [ "$waited" -ge "$PSI_WINDOW" ] && break
    sleep "$PSI_STEP"; waited=$((waited + PSI_STEP))
  done
fi
snap_io > "$TMP_B"
win_end=$(date +%s)
win_s=$((win_end - win_start)); [ "$win_s" -lt 1 ] && win_s=1

# --- offender ranking over the window (global, process-level) -----------------
# join requires pid AND starttime to match — a reused pid drops out (F5)
tops=$(awk 'NR==FNR{a[$1]=$3; st[$1]=$2; next}
            ($1 in a) && ($2 == st[$1]) {d=$3-a[$1]; if(d>0) printf "%d %s:%s\n", d, $1, $2}' \
       "$TMP_A" "$TMP_B" | sort -rn | head -3)
trig=0
[ "$psi_max_full" -ge "$PSI_TRIG" ] && trig=1

# --- fs error count for one disk = sum over its partitions --------------------
fs_err_of() {
  local dev=$1 total=0 pcnt f
  for pcnt in $(ls "/sys/block/$dev" 2>/dev/null | grep "^$dev"); do
    for f in /sys/fs/*/"$pcnt"/errors_count; do     # F2: no literal \" escapes
      [ -r "$f" ] && total=$(( total + $(cat "$f" 2>/dev/null || echo 0) ))
    done
  done
  for f in /sys/fs/*/"$dev"/errors_count; do        # whole-device filesystem (rare)
    [ -r "$f" ] && total=$(( total + $(cat "$f" 2>/dev/null || echo 0) ))
  done
  echo "$total"
}

# --- PER-DISK pass: emit one line per configured device ------------------------
any_warn=0

for dev in $DISKS; do

  if [ ! -d "/sys/block/$dev" ]; then
    # F10: the ALERT context travels on the line itself — never a bare ALERT
    miss_alerts="MISSING_DEV"
    [ "$psi_ok" -eq 0 ] && miss_alerts="MISSING_DEV MISSING_PSI"
    line=$(printf '%s dev=%s status=MISSING alerts="%s"' "$now" "$dev" "$miss_alerts")
    echo "$line" >> "$LOG"; echo "$line"
    echo "ALERT: dev=$dev status=MISSING alerts=\"$miss_alerts\"" >> "$LOG"
    echo "ALERT: dev=$dev status=MISSING alerts=\"$miss_alerts\""
    continue
  fi

  eval "$(awk -v d="$dev" '$3==d {printf "rd=%d ws=%d ifl=%d io_ms=%d", $4, $8, $12, $13}' /proc/diskstats)"
  rd=${rd:-0}; ws=${ws:-0}; ifl=${ifl:-0}; io_ms=${io_ms:-0}
  fs_err=$(fs_err_of "$dev")
  sched=$(cat "/sys/block/$dev/queue/scheduler" 2>/dev/null | awk -F'[][]' '{print $2}')
  sched=${sched:-none}

  sfile="$LIB_DIR/state.$dev"
  status=OK
  alerts=""
  busy_delta=0
  if [ -f "$sfile" ]; then
    # F9: 6 fields since the uptime column; old 5-field files use epoch fallback
    read -r -a srow < "$sfile" 2>/dev/null || srow=()
    if [ "${#srow[@]}" -ge 6 ] && num_ok "${srow[1]}"; then
      p_epoch=${srow[0]}; p_up=${srow[1]}; p_io=${srow[2]}
      p_rd=${srow[3]}; p_wr=${srow[4]}; p_err=${srow[5]}
    else
      p_epoch=${srow[0]:-0}; p_up=0; p_io=${srow[1]:-0}
      p_rd=${srow[2]:-0}; p_wr=${srow[3]:-0}; p_err=${srow[4]:-0}
    fi
    for v in p_epoch p_io p_rd p_wr p_err; do
      num_ok "${!v}" || printf -v "$v" '%s' 0
    done
    # monotonic wall time from /proc/uptime when available (clock-jump proof)
    if [ "$p_up" -gt 0 ] && [ "$up_now" -ge "$p_up" ]; then
      wall_s=$(( up_now - p_up ))
    else
      wall_s=$(( epoch - p_epoch ))     # legacy fallback
    fi
    [ "$wall_s" -lt 1 ] && wall_s=1
    busy_delta=$(( io_ms > p_io ? io_ms - p_io : 0 ))   # F3: real delta
    util_pct=$(( busy_delta * 100 / (wall_s * 1000) ))
    [ "$util_pct" -gt 100 ] && util_pct=100
    d_rd=$(( rd > p_rd ? rd - p_rd : 0 ))
    d_wr=$(( ws > p_wr ? ws - p_wr : 0 ))
    iops_r=$(( d_rd / wall_s )); iops_w=$(( d_wr / wall_s ))

    d_err=$(( ioerr > p_err ? ioerr - p_err : 0 ))
    [ "$d_err" -gt 0 ] && { alerts="${alerts:+$alerts }KERNEL_IO_ERRORS+${d_err}"; status=WARN; }
    [ "$fs_err" -gt 0 ] && { alerts="${alerts:+$alerts }FS_ERRORS=$fs_err"; status=WARN; }
    [ "$ifl" -gt 8 ]     && { alerts="${alerts:+$alerts }IN_FLIGHT_HIGH=$ifl";   status=WARN; }
    [ "$util_pct" -gt 80 ] && { alerts="${alerts:+$alerts }UTIL_HIGH=${util_pct}%"; status=WARN; }
  else
    iops_r=0; iops_w=0; util_pct=0   # BASELINE run for this disk
  fi
  printf '%s %s %s %s %s %s\n' "$epoch" "$up_now" "$io_ms" "$rd" "$ws" "$ioerr" > "$sfile" 2>/dev/null || true

  if [ "$trig" -eq 1 ]; then
    alerts="${alerts:+$alerts }PSI_HIGH=${psi_max_full}%"; status=WARN
  fi
  # F1: PSI missing → WARN + MISSING_PSI on every emitted line
  if [ "$psi_ok" -eq 0 ]; then
    alerts="${alerts:+$alerts }MISSING_PSI"; status=WARN
  fi
  [ "$status" = "WARN" ] && any_warn=1

  line=$(printf '%s dev=%s load_1m=%s load_5m=%s load_15m=%s in_flight=%d iops_read=%s iops_write=%s busy_ms_delta=%dms util_pct=%d iowait_pct=%s kernel_io_errors=%d fs_errors=%d psi_io_some_max=%d psi_io_full_max=%d sched=%s status=%s' \
    "$now" "$dev" "$load1" "$load5" "$load15" "$ifl" "$iops_r" "$iops_w" "$busy_delta" "$util_pct" "$iowait_pct" "$ioerr" "$fs_err" "$psi_max_some" "$psi_max_full" "$sched" "$status")
  [ -n "$alerts" ] && line="$line alerts=\"$alerts\""
  echo "$line" >> "$LOG"; echo "$line"
done

# --- offender reporting (global, process-level) -------------------------------
off_list=""; act=""; hint_line=""
restored_lines=()
min_bytes=$(( IO_TRIG_MBPS * 1024 * 1024 * win_s ))   # F4: MiB per window
reported=0
if [ "$trig" -eq 1 ]; then
  while read -r d pentry; do
    pid=${pentry%%:*}; pstart=${pentry##*:}
    [ "$d" -lt "$min_bytes" ] && continue
    [ -r "/proc/$pid/comm" ] || continue
    mb=$(( d / (1024 * 1024) ))
    comm_name=$(cat "/proc/$pid/comm" 2>/dev/null | tr -cd '[:alnum:]._-')  # F8
    off_list="${off_list:+$off_list }off$((reported+1))=${pid}:${comm_name}:${mb}MiB"
    reported=$((reported + 1))
  done <<EOF
$tops
EOF
fi

# --- per-entry recovery counters (F6/I2): tick EVERY recorded entry, every run
# (a re-offender resets to 0; a demoted pid that stays out of this run's tops
# set earns one more clean run — covering triggered and clean runs alike; the
# old single global clean counter let a chronic offender hold a one-time
# victim hostage, per-entry counters restore the victim on its own merits)
tops_keys=$(printf '%s\n' "$tops" | awk 'NF{print $2}' | tr '\n' ' ')
m_demoted_new=""
for entry in ${m_demoted:-}; do
  demoted_parse "$entry"
  proc_alive "$d_pid" "$d_start" || continue            # exited — drop silently
  case " $tops_keys " in
    *" $d_pid:$d_start "*) d_clean=0 ;;                 # offender this run again
    *)                     d_clean=$((d_clean + 1)) ;;  # one more clean run
  esac
  m_demoted_new="${m_demoted_new:+$m_demoted_new }$d_pid:$d_start:$d_nice:$d_iclass:$d_iprio:$d_clean"
done
m_demoted=$m_demoted_new

# --- demotion recovery (F6/I1): per-entry — restore at clean>=2 REGARDLESS of
# the global trigger, renice+ionice EXACTLY to the recorded values
keep=""
for entry in ${m_demoted:-}; do
  demoted_parse "$entry"
  if [ "$d_clean" -ge 2 ]; then
    proc_alive "$d_pid" "$d_start" || continue            # exited — drop silently
    if renice -n "$d_nice" -p "$d_pid" >/dev/null 2>&1 \
       && restore_ionice "$d_pid" "$d_nice" "$d_iclass" "$d_iprio"; then
      if [ "$r_kdef" -eq 1 ]; then
        restored_lines+=("restored: pid=$d_pid nice=$d_nice ionice=$r_label (kernel default)")
      else
        restored_lines+=("restored: pid=$d_pid nice=$d_nice ionice=$r_label")
      fi
    else
      restored_lines+=("restore failed: pid=$d_pid nice=$d_nice")
    fi
  else
    keep="${keep:+$keep }$entry"
  fi
done
m_demoted=$keep

# --- reactive mitigation: demote THIS run's new offenders ---------------------
if [ "$trig" -eq 1 ] && [ "$MITIGATE" -ge 1 ] && [ "$reported" -gt 0 ]; then
  acted=0; acted_pids=""
  if [ $(( epoch - m_last )) -ge "$COOLDOWN" ]; then
    while read -r d pentry; do
      pid=${pentry%%:*}; pstart=${pentry##*:}
      [ "$pid" -le 2 ] && continue
      [ "$d" -lt "$min_bytes" ] && continue
      proc_alive "$pid" "$pstart" || continue    # F5: pid-reuse re-check
      [ -r "/proc/$pid/comm" ] || continue
      if [ "$MITIGATE" -ge 1 ]; then
        # F6/I1: remember the original nice AND I/O class+level once, so the
        # demotion can be undone exactly; the entry starts its per-entry
        # clean counter at 0 (I2)
        if ! demoted_has "$pid" "$pstart"; then
          onice=$(proc_nice "$pid"); num_ok "$onice" || onice=0
          iop=$(ionice_get "$pid"); iop=${iop:-"2 4"}
          o_iclass=${iop%% *}; o_iprio=${iop##* }
          case $o_iclass in ''|*[!0-9]*) o_iclass=2 ;; esac
          case $o_iprio  in ''|*[!0-9]*) o_iprio=4 ;;  esac
          m_demoted="${m_demoted:+$m_demoted }$pid:$pstart:$onice:$o_iclass:$o_iprio:0"
        fi
        ionice -c 3 -p "$pid" 2>/dev/null && renice -n 19 -p "$pid" >/dev/null 2>&1 \
          && { acted=1; acted_pids="${acted_pids:+$acted_pids,}$pid"; }
      fi
      if [ "$MITIGATE" -ge 2 ]; then
        stopped_pid=$pid; stopped_start=$pstart
        m_stopped_pid=$pid; m_stopped_start=$pstart
        mstate_write                             # F7: record BEFORE the STOP
        kill -STOP "$pid" 2>/dev/null || {
          stopped_pid=0; stopped_start=0; m_stopped_pid=0; m_stopped_start=0
          mstate_write                       # revert the pre-STOP record
        }
        break   # pendulum: at most one process frozen per run
      fi
    done <<EOF
$tops
EOF
    if [ "$acted" -eq 1 ]; then
      act="${act:+$act }ionice+renice pids=$acted_pids"
      # I3: one-time non-BFQ hint — once per mitigate.state lifetime
      if [ "$m_hint_bfq" != "1" ]; then
        h_sched=""
        for hdev in $DISKS; do
          hs=$(cat "/sys/block/$hdev/queue/scheduler" 2>/dev/null | awk -F'[][]' '{print $2}')
          if [ -n "$hs" ]; then h_sched=$hs; break; fi
        done
        if [ -n "$h_sched" ] && [ "$h_sched" != "bfq" ]; then
          hint_line="hint: scheduler is $h_sched — ionice demotion is fully binding only under bfq"
          m_hint_bfq=1
        fi
      fi
    fi
    m_last=$epoch
  else
    act="cooldown $(( COOLDOWN - (epoch - m_last) ))s"
  fi
fi

# --- append offender/action/hint/restored lines to this run's log --------------
if [ -n "$off_list" ]; then echo "offenders: $off_list" >> "$LOG"; echo "offenders: $off_list"; fi
if [ -n "$act" ]; then echo "action: $act" >> "$LOG"; echo "action: $act"; fi
if [ -n "$hint_line" ]; then echo "$hint_line" >> "$LOG"; echo "$hint_line"; fi
if [ "${#restored_lines[@]}" -gt 0 ]; then
  printf '%s\n' "${restored_lines[@]}" >> "$LOG"
  printf '%s\n' "${restored_lines[@]}"
fi

# persist mitigation state (single writer point at end of run)
mstate_write

[ "$any_warn" -eq 1 ] && echo "ALERT: see status=WARN lines above"
exit 0
